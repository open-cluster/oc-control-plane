# Copy to .env and fill in file paths. `.env` is gitignored and must never hold a secret.
# Credential-bearing settings always name mounted files.

OC_SERVER_ADDRESS=127.0.0.1:8080
OC_PUBLIC_URL=http://localhost:8080
OC_DATABASE_DSN_FILE=.secrets/database.dsn
OC_AUTH_MODE=local
OC_BOOTSTRAP_TOKEN_FILE=.secrets/bootstrap.token
OC_ENCRYPTION_KEY_FILE=.secrets/encryption.key

OC_AI_PROVIDER=anthropic
OC_AI_MODEL=claude-sonnet-5
OC_AI_API_KEY_FILE=.secrets/model.key

# Optional deployment OIDC.
#OC_OIDC_ISSUER=https://identity.example.com
#OC_OIDC_CLIENT_ID=opencluster
#OC_OIDC_CLIENT_SECRET_FILE=.secrets/oidc-client-secret

# Optional outbound Relay listener.
#OC_RELAY_ADDRESS=127.0.0.1:8443
#OC_RELAY_SPKI_PINS=

# Optional telemetry.
OC_LOG_LEVEL=info
#OC_OTLP_ENDPOINT=

# Optional Slack App.
#OC_SLACK_CLIENT_ID=
#OC_SLACK_CLIENT_SECRET_FILE=.secrets/slack-client-secret
#OC_SLACK_SIGNING_SECRET_FILE=.secrets/slack-signing-secret

# Optional GitHub App.
#OC_GITHUB_APP_ID=
#OC_GITHUB_APP_PRIVATE_KEY_FILE=.secrets/github-app.pem
