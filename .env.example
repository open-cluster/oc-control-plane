# Copy to .env and fill in. `.env` is gitignored; this file is not, and must never hold a secret.
#
# Nothing here carries a credential. Every secret in this product is a FILE PATH, because an
# environment value is readable from a process listing and appears in every diagnostic dump of
# the environment. `.env` holds the paths; the files hold the keys.

# ---------------------------------------------------------------------------------------------
# Listeners. Each surface has its own, so a deployment can publish one without the rest.
# ---------------------------------------------------------------------------------------------

# Health, readiness and metrics. Required.
OC_HTTP_ADDRESS=127.0.0.1:8080

# The Relay endpoint. Empty serves no relays. With relays, OC_RELAY_SPKI_PINS is required.
#OC_RELAY_ADDRESS=127.0.0.1:8443
#OC_RELAY_SPKI_PINS=

# The operator surface. Empty exposes it nowhere.
#OC_OPERATOR_ADDRESS=127.0.0.1:8081
#OC_OPERATOR_TOKEN_FILE=.secrets/operator.token
#OC_OPERATOR_TOKEN_ORGANIZATION=org-local
#OC_OPERATOR_PUBLIC_URL=
#OC_OPERATOR_CONSOLE_URL=
#OC_OPERATOR_ALLOWED_ORIGINS=
#OC_IDENTITY_ENCRYPTION_KEY_FILE=.secrets/identity.key

# Alert intake. Empty takes no alerts. The public URL is what an Integration's webhook
# address is built from — it is pasted into a customer's own alerting, so it must be the
# origin THAT system reaches, never this listener's own.
#OC_INTAKE_ADDRESS=127.0.0.1:8082
#OC_INTAKE_PUBLIC_URL=

# ---------------------------------------------------------------------------------------------
# Storage. A placement's DSN carries a password, so it is a file path.
# ---------------------------------------------------------------------------------------------

OC_PLACEMENTS=shared=.secrets/shared.dsn
OC_DEFAULT_PLACEMENT=shared
#OC_PLACEMENT_ASSIGNMENTS=

# ---------------------------------------------------------------------------------------------
# Optional.
# ---------------------------------------------------------------------------------------------

#OC_SHUTDOWN_TIMEOUT=15s
#OC_SERVICE_NAME=oc-control-plane
#OC_OTLP_ENDPOINT=
#OC_MINIMUM_RELAY_VERSION=
#OC_CHANGE_LEDGER_RETENTION_DAYS=90
