# Standalone Go process settings. Copy to .env and fill in file paths.
# Export these values before starting; the process does not load .env automatically.
# POSIX shell: set -a; . ./.env; set +a; go run ./cmd/controlplane
# Compose consumes OPENCLUSTER_* inputs instead; see docs/getting-started/quickstart.mdx.
# Do not commit credentials.
# These examples use files; direct secret values are also supported. Never set both forms.

OC_SERVER_ADDRESS=127.0.0.1:8081
OC_PUBLIC_URL=http://localhost:8081
OC_DATABASE_DSN_FILE=.secrets/database.dsn
OC_SESSION_LIFETIME_SECONDS=43200
OC_BOOTSTRAP_TOKEN_FILE=.secrets/bootstrap.token
OC_ENCRYPTION_KEY_FILE=.secrets/encryption.key

OC_AI_PROVIDER=anthropic
OC_AI_MODEL=claude-sonnet-5
OC_AI_API_KEY_FILE=.secrets/model.key
# OpenRouter: set OC_AI_PROVIDER=openrouter and a full model ID such as z-ai/glm-4.7.
# Optional output allowance, including reasoning; lower it for smaller models.
#OC_AI_MAX_OUTPUT_SIZE=32000

# Optional deployment OIDC.
#OC_OIDC_ISSUER=https://identity.example.com
#OC_OIDC_CLIENT_ID=opencluster
#OC_OIDC_CLIENT_SECRET_FILE=.secrets/oidc-client-secret

# Optional outbound Relay listener.
#OC_RELAY_ADDRESS=127.0.0.1:8443
#OC_RELAY_SPKI_PINS=

# Optional telemetry.
OC_LOG_LEVEL=info
#OC_OTLP_ENDPOINT=

# Optional Slack App.
#OC_SLACK_CLIENT_ID=
#OC_SLACK_CLIENT_SECRET_FILE=.secrets/slack-client-secret
#OC_SLACK_SIGNING_SECRET_FILE=.secrets/slack-signing-secret

# Optional GitHub App.
#OC_GITHUB_APP_ID=
#OC_GITHUB_APP_PRIVATE_KEY_FILE=.secrets/github-app.pem
