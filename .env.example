# Copy to .env and fill in. `.env` is gitignored; this file is not, and must never hold a secret.
#
# Nothing here carries a credential. Every secret in this product is a FILE PATH, because an
# environment value is readable from a process listing and appears in every diagnostic dump of the
# environment. `.env` holds the paths; the files hold the keys.
#
# `scripts/live-model.sh` sources this if it exists.

# ---------------------------------------------------------------------------------------------
# The model deployment. Unset OC_MODEL_PROVIDER and the control plane behaves exactly as it does
# today: a recorded transcript if one is named, and honest failed rounds otherwise.
# ---------------------------------------------------------------------------------------------

# anthropic | zai
OC_MODEL_PROVIDER=zai

# The exact model identifier. No suffix is ever appended to it: a constructed identifier is a 404
# at best and a different model at worst. Priced models are listed by `scripts/live-model.sh config`.
OC_MODEL_NAME=glm-5

# A path to a file holding the key, and nothing else. Never the key itself.
OC_MODEL_KEY_FILE=.secrets/zai.key

# low | medium | high | xhigh | max. The primary cost and latency lever: on a model that thinks
# before answering, reasoning has been measured at 78% of output tokens, so this moves the bill
# more than anything else here.
OC_MODEL_EFFORT=high

# Which providers may be sent this deployment's evidence. NOTHING LISTED PERMITS NOTHING: a
# provider configured above but absent here is a refusal to start rather than a round that fails
# later. The question a customer answers is about a subprocessor, so it is not implied by having
# configured one.
OC_MODEL_CONSENTED_PROVIDERS=zai

# A spending limit across rounds, in micro-cents. Unset means no ceiling, which is an operator fact
# and not a currency. 500000000 is about $5. One round of the red-herring scenario cost about
# $0.03 on glm-5.
OC_MODEL_COST_CEILING_MICROCENTS=500000000

# Optional bounds on one call. Unset uses the package defaults, which are sized for a model that
# thinks: 32000 output tokens and a five-minute per-call timeout.
#OC_MODEL_MAX_OUTPUT=32000
#OC_MODEL_MAX_PROMPT=400000
#OC_MODEL_BASE_URL=https://api.z.ai

# ---------------------------------------------------------------------------------------------
# The one optional fallback hop. Never inferred: a deployment that configures none gets an honest
# failure rather than a vendor nobody chose. It needs its own entry in CONSENTED_PROVIDERS, because
# consenting to one vendor is not consenting to the next.
# ---------------------------------------------------------------------------------------------

#OC_MODEL_FALLBACK_PROVIDER=anthropic
#OC_MODEL_FALLBACK_NAME=claude-opus-5
#OC_MODEL_FALLBACK_KEY_FILE=.secrets/anthropic.key

# ---------------------------------------------------------------------------------------------
# The control plane itself. None of this is about the model.
# ---------------------------------------------------------------------------------------------

OC_HTTP_ADDRESS=127.0.0.1:8080

# name=path-to-dsn-file. The DSN carries a password, so it is a file for the same reason the model
# key is.
OC_PLACEMENTS=shared=.secrets/shared.dsn
OC_DEFAULT_PLACEMENT=shared

# The Relay endpoint and the key digests a Relay pins its next connection to. Both are required
# together: a Relay handed no pin would have to trust a certificate authority instead.
#OC_RELAY_ADDRESS=127.0.0.1:8443
#OC_RELAY_SPKI_PINS=

# The operator surface reads across every tenant this instance serves, so its token must be at
# least 32 characters and lives in a file.
#OC_OPERATOR_ADDRESS=127.0.0.1:8081
#OC_OPERATOR_TOKEN_FILE=.secrets/operator.token

# Alert intake. The only surface a customer's own infrastructure connects to inbound.
#OC_INTAKE_ADDRESS=127.0.0.1:8082

OC_SERVICE_NAME=oc-control-plane
OC_SHUTDOWN_TIMEOUT=15s
#OC_OTLP_ENDPOINT=127.0.0.1:4317
