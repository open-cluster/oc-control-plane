# Binaries and build output
/bin/
/dist/
*.exe
*.test
*.out

# Coverage and profiling
coverage.*
*.prof

# Crash artefacts
*.stackdump

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Local environment (never committed; credentials never live in this repo).
# The glob covers the copies an operator or a tool leaves behind — .env.backup-*, .env.local
# — because one of those being untracked is how a local deployment's configuration reaches a
# commit. .env.example is committed on purpose and is re-admitted below it.
.env
.env.*
!.env.example
*.local.yaml

# Local credentials. Never committed: the model key is read from a file path so that it
# cannot leak through a process listing or a diagnostic dump of the environment.
.secrets/

# Harness output. A run files artifacts, ground truth and scores here; they are EVIDENCE of one
# run rather than source, and the ones worth keeping are copied into docs/evidence by hand so that
# what is committed is a decision rather than whatever the last run happened to leave behind.
/artifacts/
/artifacts-sweep/
/artifacts-rerun/
/.tmp/

# AI-assisted development working state (local-only)
# See github.com/open-cluster/engineering: ai/repository-boundaries.md
/.agents/
/.claude/
/skills-lock.json
/plans/
/learning-records/
/lessons/
/reference/
/assets/
